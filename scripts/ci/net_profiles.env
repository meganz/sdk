# net_profiles.env — network-shaping profile registry for SDK-5360 WS-upload
# poor-network reproduction (consumed by scripts/ci/netem_profile.sh).
#
# Each profile maps a name to: "delay_ms loss_pct kbps"
#   delay_ms : one-way latency added to EACH veth egress (so RTT ~= 2*delay_ms)
#   loss_pct : packet-loss percentage applied to EACH veth egress
#   kbps     : upload bandwidth cap in kilobits/sec, passed to the SDK via
#              MEGA_NET_MAXUPLOAD_KBPS (NOT via netem rate). 0 = unlimited.
#
# Both human-readable (KEY=VALUE, sourceable) and machine-usable: the wrapper
# sources this file and reads NET_PROFILE_<name> (sanitized) or falls back to a
# direct KEY lookup. To stay sourceable from bash, values are quoted strings.
#
# profile: delay_ms(each way) loss_pct(each way) kbps(upload; 0=unlimited)

clean="0 0 0"
poorRTT="500 0 0"
loss5="500 5 0"
loss20="500 20 0"
loss50="500 50 0"
loss100="500 100 0"
qaexact="500 10 1000"

# --- followup8_QA Session 2 (HR57) expansion ---------------------------------
# RTT-alone ladder (loss=0, kbps=0): isolate per-chunk-ack RTT sensitivity of
# the WS send/ack path independent of loss. Wire RTT ~= 2*delay_ms.
rtt200="200 0 0"      # 400 ms wire RTT  — distant home broadband (low anchor)
# poorRTT (above) = 500/0/0 = 1000 ms wire RTT — congested mobile (mid anchor)
rtt1000="1000 0 0"    # 2000 ms wire RTT — satellite / bufferbloat (high anchor)
# Mixed RTT+loss (kbps cap models a real uplink); qaexact is the QA repro point.
mixedMid="500 15 1000"  # 1000 ms RTT + 15% loss + 1 Mbit — pure-loss step from qaexact
mixedHigh="750 20 1000" # 1500 ms RTT + 20% loss + 1 Mbit — worst recoverable field case
# Bandwidth-capped heavy-loss (the cap keeps the cs control channel alive so the
# UPLOAD path is actually entered/observable; uncapped loss20/50 wedge at login).
loss20cap="500 20 1000"  # the E-2 mechanism-trace profile (S2 vs S3 isolation)
loss30cap="500 30 1000"  # fix-validation ladder
loss40cap="500 40 1000"  # fix-validation ladder
